# Build intermediates: `tsc -b` emits these next to the declarations, and
# tsdown bundles them into lib/index.js. Only the three real artifacts below
# are committed, because a git-sourced install must find them without running
# a build script.
lib/types/*.js
lib/types/*.js.map
lib/*.tsbuildinfo
lib/types/*.tsbuildinfo

node_modules/
*.tgz
*.log
.DS_Store
